{
  "name": "ukiyora-character-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ukiyora-characters",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://ukiyora.com,https://www.ukiyora.com,http://localhost:3000"
  }
}
